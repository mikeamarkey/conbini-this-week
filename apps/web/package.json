{
  "name": "conbini-this-week-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "checks": "pnpm /checks:.*/",
    "checks:lint": "eslint . --ext ts --ext tsx --ext js",
    "checks:prettier": "prettier --check .",
    "checks:tsc": "tsc --pretty --noEmit",
    "fix": "pnpm /fix:.*/",
    "fix:lint": "pnpm checks:lint --fix",
    "fix:prettier": "prettier --write .",
    "staged": "lint-staged --allow-empty",
    "start": "next start",
    "test": "jest"
  },
  "dependencies": {
    "@vercel/analytics": "1.6.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-use": "17.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.4.21",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
